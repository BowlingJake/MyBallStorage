digraph "" {
  graph [style=rounded fontname="Arial Black" fontsize=13 penwidth=2.6];
  node [shape=rect style="filled,rounded" fontname=Arial fontsize=15 fillcolor=Lavender penwidth=1.3];
  edge [penwidth=1.3];
  "/a.dart" [label="a"];
  "/b.dart" [label="b"];
  subgraph "cluster~" {
    label="lib";
    "/a.dart";
    "/b.dart";
  }
}
