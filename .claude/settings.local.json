{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(dart run build_runner:*)",
      "Bash(dart analyze:*)",
      "Bash(mv:*)",
      "Bash(rmdir:*)",
      "Bash(flutter analyze:*)",
      "Bash(mkdir:*)",
      "Bash(flutter pub run build_runner build:*)",
      "Bash(flutter run:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git restore:*)",
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Bash(rm:*)",
      "Bash(flutter build:*)",
      "Bash(flutter pub:*)",
      "Bash(flutter:*)",
      "Bash(dart:*)",
      "Bash(git push:*)"
    ],
    "deny": [],
    "defaultMode": "acceptEdits"
  }
}